<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="493.0" prefWidth="881.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.example.aula2exercicio1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <TextField fx:id="idNome" promptText="Nome do solicitante" />
      <ComboBox fx:id="idSetor" prefHeight="25.0" prefWidth="226.0" promptText="Setor" />
      <ComboBox fx:id="idCategoria" layoutX="376.0" layoutY="267.0" prefWidth="150.0" promptText="Categoria" />
      <TextField fx:id="idDescricao" layoutX="30.0" layoutY="177.0" promptText="Descrição do problema" />
      <ComboBox fx:id="idPrioridade" layoutX="376.0" layoutY="289.0" prefWidth="150.0" promptText="Prioridade" />
      <Button fx:id="idRegistro" mnemonicParsing="false" onAction="#AbrirChamado" text="Registrar chamado" />
      <TextArea fx:id="idResultado" prefHeight="200.0" prefWidth="200.0" />
   </children>
</VBox>
